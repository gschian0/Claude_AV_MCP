{
  "mcpServers": {
    "av-conductor": {
      "command": "uv",
      "args": ["run", "--directory", ".", "av-conductor"]
    },
    "ableton": {
      "command": "uvx",
      "args": ["ableton-mcp"],
      "env": {
        "ABLETON_MCP_DISABLE_TELEMETRY": "true",
        "ABLETON_MCP_DISABLE_DATASET": "true"
      }
    },
    "maxmsp": {
      "command": "vendor/MaxMSP-MCP-Server/.venv/bin/python",
      "args": ["vendor/MaxMSP-MCP-Server/server.py"]
    }
  }
}
